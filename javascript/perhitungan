<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cek Kelulusan & Dark Mode</title>
    <!-- Menggunakan Bootstrap 5 untuk styling dasar card dan form -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* CSS yang sudah diperbaiki sebelumnya */
        body {
            background-color: #f8f9fa;
            color: #212529;
            transition: background-color 0.3s, color 0.3s;
        }

        body.dark {
            background-color: #212529;
            color: white;
        }

        body.dark .card {
            background-color: #343a40;
            color: white;
            border-color: #495057;
        }

        body.dark .form-control {
            background-color: #495057;
            color: white;
            border-color: #6c757d;
        }

        body.dark .form-control::placeholder {
            color: #ced4da;
        }
    </style>
</head>
<body class="py-5">

    <div class="container" style="max-width: 600px;">
        <!-- Tombol Toggle Dark Mode -->
        <div class="d-flex justify-content-end mb-3">
            <button id="toggleTheme" class="btn btn-outline-secondary btn-sm">🌙 Dark Mode</button>
        </div>

        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title mb-4 text-center">Penghitung Nilai & Kelulusan</h3>
                
                <form id="formKelulusan">
                    <div class="mb-3">
                        <label for="nilai1" class="form-label">Nilai Mata Kuliah 1</label>
                        <input type="number" class="form-control" id="nilai1" placeholder="Contoh: 75" required min="0" max="100">
                    </div>
                    <div class="mb-3">
                        <label for="nilai2" class="form-label">Nilai Mata Kuliah 2</label>
                        <input type="number" class="form-control" id="nilai2" placeholder="Contoh: 80" required min="0" max="100">
                    </div>
                    <div class="mb-3">
                        <label for="nilai3" class="form-label">Nilai Mata Kuliah 3</label>
                        <input type="number" class="form-control" id="nilai3" placeholder="Contoh: 65" required min="0" max="100">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Hitung & Cek Status</button>
                </form>

                <!-- Area Hasil -->
                <div id="hasilContainer" class="mt-4 d-none">
                    <hr>
                    <h5 class="mb-3">Hasil Evaluasi:</h5>
                    <p class="mb-1">Rata-rata Nilai: <strong id="valRataRata">-</strong></p>
                    <p class="mb-0">Status: <span id="valStatus" class="badge">-</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript untuk Interaksi & Logika Kelulusan -->
    <script>
        // Logika Toggle Dark Mode
        const toggleBtn = document.getElementById('toggleTheme');
        toggleBtn.addEventListener('click', () => {
            document.body.classList.toggle('dark');
            if (document.body.classList.contains('dark')) {
                toggleBtn.textContent = '☀️ Light Mode';
                toggleBtn.classList.replace('btn-outline-secondary', 'btn-outline-light');
            } else {
                toggleBtn.textContent = '🌙 Dark Mode';
                toggleBtn.classList.replace('btn-outline-light', 'btn-outline-secondary');
            }
        });

        // Logika Penghitungan Nilai & Kelulusan
        const form = document.getElementById('formKelulusan');
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            // Mengambil nilai input
            let n1 = parseFloat(document.getElementById('nilai1').value);
            let n2 = parseFloat(document.getElementById('nilai2').value);
            let n3 = parseFloat(document.getElementById('nilai3').value);

            // Menghitung rata-rata
            let rataRata = (n1 + n2 + n3) / 3;
            let batasLulus = 60; // Standar batas lulus

            // Menentukan status kelulusan (dengan validasi tambahan agar tidak ada nilai di bawah 50)
            let status = "";
            let badgeClass = "";

            if (rataRata >= batasLulus && n1 >= 50 && n2 >= 50 && n3 >= 50) {
                status = "LULUS";
                badgeClass = "bg-success";
            } else {
                status = "TIDAK LULUS";
                badgeClass = "bg-danger";
            }

            // Menampilkan hasil ke elemen HTML
            document.getElementById('valRataRata').textContent = rataRata.toFixed(2);
            
            const statusBadge = document.getElementById('valStatus');
            statusBadge.textContent = status;
            statusBadge.className = `badge ${badgeClass}`;

            // Munculkan container hasil
            document.getElementById('hasilContainer').classList.remove('d-none');
        });
    </script>
</body>
</html>